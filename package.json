{
  "name": "@juraai/contracts",
  "version": "0.1.0",
  "private": false,
  "description": "Jura AI — shared cross-repo contracts (JSON Schema, codegen to TypeScript + Python). Single source of truth for concepts shared across jura-app, jura-data, and jura-review.",
  "type": "module",
  "main": "./generated/typescript/src/index.ts",
  "types": "./generated/typescript/src/index.ts",
  "exports": {
    ".": "./generated/typescript/src/index.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "codegen": "node codegen/generate.mjs",
    "test": "node --test codegen/*.test.mjs validators/typescript/src/*.test.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "json-schema-to-zod": "^2.8.1",
    "zod": "^4.4.3",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.65.0",
    "typescript": "^5"
  }
}
